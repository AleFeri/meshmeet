# Browser-visible Convex deployment URL. This is not a secret.
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex CLI deployment selector. Do not rename with a PUBLIC_ prefix.
CONVEX_DEPLOYMENT=dev:your-deployment

# Set these in the Convex deployment with `convex env set`, not on the static frontend host:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
